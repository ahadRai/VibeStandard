# EC2 Deployment Configuration
# Copy this file to .env and update with your domain and settings

# Domain and SSL
DOMAIN=yourdomain.com
EMAIL=admin@yourdomain.com

# API Configuration
CORS_ORIGINS=https://yourdomain.com
DEBUG=false

# Frontend API URL (used during build — use /api path through proxy)
VITE_API_URL=https://yourdomain.com/api
